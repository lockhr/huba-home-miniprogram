:host {
  display: block;
  width: 100%;
}

.brand-header {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  padding-left: 34rpx;
  padding-right: 28rpx;
  padding-bottom: 20rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.95) 0, rgba(255, 255, 255, 0) 38%),
    linear-gradient(135deg, #fffafc 0%, #ffe9f1 100%);
}

.brand-copy {
  position: relative;
  z-index: 2;
  padding-top: 10rpx;
  overflow: hidden;
}

.brand-title {
  color: #092a49;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.85);
}

.brand-tagline {
  margin-top: 10rpx;
  color: #8393aa;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 24rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.brand-mascots {
  position: absolute;
  z-index: 1;
  bottom: -22rpx;
  width: 190rpx;
  height: 142rpx;
}

.spark {
  position: absolute;
  z-index: 1;
  font-size: 26rpx;
}

.spark-one {
  top: 32%;
  right: 43%;
  color: #ffd66b;
}

.spark-two {
  top: 46%;
  right: 38%;
  color: #ff5d91;
}
