.dish-form-page { min-height: 100vh; padding: 28rpx 28rpx calc(70rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: radial-gradient(circle at 90% 8%,rgba(255,198,220,.45),transparent 30%),linear-gradient(180deg,#fff7fa,#fbfcfe 72%,#fff); }
.form-intro { position: relative; display: flex; align-items: center; padding: 22rpx 24rpx; overflow: hidden; border-radius: 28rpx; background: linear-gradient(130deg,#fff,#ffeaf2); box-shadow: 0 10rpx 25rpx rgba(131,77,101,.09); }.intro-icon { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-right: 18rpx; border-radius: 26rpx 26rpx 26rpx 8rpx; background: rgba(255,255,255,.82); font-size: 42rpx; }.intro-title { color: #092a49; font-size: 29rpx; font-weight: 800; }.intro-note { margin-top: 6rpx; color: #8a96a7; font-size: 21rpx; }.intro-star { position: absolute; right: 20rpx; top: 13rpx; color: #ff7ea9; font-size: 26rpx; }
.photo-picker { position: relative; display: flex; align-items: center; justify-content: center; height: 310rpx; margin-top: 22rpx; overflow: hidden; border: 3rpx dashed #f4c9d9; border-radius: 30rpx; background: rgba(255,255,255,.8); }.photo-picker image { width: 100%; height: 100%; }.photo-empty { display: flex; align-items: center; flex-direction: column; color: #62758b; font-size: 25rpx; }.photo-empty>text:last-child { margin-top: 8rpx; color: #a6afbb; font-size: 20rpx; }.photo-icon { margin-bottom: 9rpx; font-size: 57rpx; }.photo-change { position: absolute; right: 18rpx; bottom: 16rpx; padding: 10rpx 18rpx; border-radius: 20rpx; color: #fff; background: rgba(9,42,73,.72); font-size: 20rpx; }.remove-photo { margin: 10rpx 8rpx 0; color: #cf6a8e; font-size: 20rpx; text-align: right; }
.form-card { margin-top: 22rpx; overflow: hidden; border: 2rpx solid #f1e6eb; border-radius: 30rpx; background: rgba(255,255,255,.95); box-shadow: 0 12rpx 30rpx rgba(111,74,92,.08); }.field { padding: 23rpx 25rpx; }.field:not(:last-child) { border-bottom: 2rpx solid #f7edf2; }.field-label { margin-bottom: 13rpx; color: #092a49; font-size: 24rpx; font-weight: 750; }.field-label text { margin-right: 8rpx; }.field input { box-sizing: border-box; height: 68rpx; padding: 0 17rpx; border-radius: 18rpx; color: #092a49; background: #fff5f8; font-size: 25rpx; }.field-placeholder { color: #b2bac5; }.minutes-line { display: flex; align-items: center; }.minutes-line input { width: 180rpx; margin-right: 12rpx; }.minutes-line text { color: #8492a5; font-size: 23rpx; }
.category-title { display: flex; align-items: baseline; justify-content: space-between; margin: 28rpx 8rpx 15rpx; color: #092a49; font-size: 28rpx; font-weight: 800; }.category-title text { color: #a198a3; font-size: 19rpx; font-weight: 400; }.category-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; }.category-option { position: relative; display: flex; align-items: center; flex-direction: column; justify-content: center; height: 126rpx; border: 2rpx solid #f0e6eb; border-radius: 24rpx; color: #68798d; background: rgba(255,255,255,.9); font-size: 22rpx; }.category-option>text { margin-bottom: 5rpx; font-size: 37rpx; }.category-option.active { border-color: #ff8ab0; color: #d84f82; background: linear-gradient(145deg,#fff,#ffe8f1); box-shadow: 0 8rpx 20rpx rgba(255,76,139,.12); }.category-check { position: absolute; right: 9rpx; top: 7rpx; color: #ff4c8b; font-size: 18rpx; }
.save-dish { display: flex; align-items: center; justify-content: center; height: 92rpx; margin-top: 30rpx; border: 5rpx solid rgba(255,255,255,.88); border-radius: 48rpx; color: #fff; background: linear-gradient(135deg,#ff72a4,#ff3f83); box-shadow: 0 12rpx 28rpx rgba(255,76,139,.25); font-size: 27rpx; font-weight: 800; }.save-dish text { margin-right: 10rpx; font-size: 35rpx; }.save-dish.disabled { opacity: .55; }
