.guide-page { min-height: 100vh; padding: 28rpx 28rpx calc(90rpx + env(safe-area-inset-bottom)); color: #41343a; background: #fbf7f2; }
.guide-cover { position: relative; box-sizing: border-box; min-height: 360rpx; padding: 44rpx 38rpx; overflow: hidden; border: 2rpx solid #eaded4; border-radius: 8rpx 48rpx 8rpx 8rpx; background: linear-gradient(145deg,#fffdf9 0%,#f8e9df 100%); box-shadow: 0 20rpx 50rpx rgba(83,55,45,.1); }
.guide-cover::after { position: absolute; right: -70rpx; bottom: -110rpx; width: 310rpx; height: 310rpx; border: 38rpx solid rgba(209,115,115,.11); border-radius: 50%; content: ""; }
.guide-edition { color: #9b7568; font-size: 18rpx; font-weight: 800; letter-spacing: 4rpx; }
.guide-title { width: 510rpx; margin-top: 46rpx; font-family: "STKaiti","KaiTi",serif; font-size: 58rpx; font-weight: 850; line-height: 1.16; }
.guide-title text { color: #c85d68; }
.guide-lead { width: 480rpx; margin-top: 24rpx; color: #76645e; font-size: 24rpx; line-height: 1.75; }
.guide-seal { position: absolute; right: 34rpx; top: 34rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 88rpx; height: 88rpx; padding: 12rpx; border: 4rpx double #c86a6a; border-radius: 50%; color: #b34f58; font-size: 20rpx; font-weight: 800; line-height: 1.15; text-align: center; transform: rotate(8deg); }
.guide-section { margin-top: 48rpx; }
.guide-number { color: #c77272; font-family: Georgia,serif; font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.guide-heading { margin-top: 5rpx; font-family: "STKaiti","KaiTi",serif; font-size: 39rpx; font-weight: 850; }
.guide-copy { margin-top: 16rpx; color: #71625e; font-size: 24rpx; line-height: 1.8; }
.journey-card { margin-top: 24rpx; padding: 30rpx; border-left: 8rpx solid #cb6a70; background: #fffdf9; box-shadow: 0 12rpx 32rpx rgba(83,55,45,.07); }
.journey-step { display: flex; align-items: flex-start; }
.journey-step>text { display: flex; align-items: center; justify-content: center; flex: none; width: 46rpx; height: 46rpx; margin-right: 20rpx; border-radius: 50%; color: #fff; background: #35556a; font-family: Georgia,serif; font-size: 21rpx; }
.journey-step>view>view { font-size: 27rpx; font-weight: 800; }
.journey-step>view>text { display: block; margin-top: 5rpx; color: #806f69; font-size: 22rpx; line-height: 1.6; }
.journey-line { width: 2rpx; height: 34rpx; margin: 5rpx 0 5rpx 22rpx; background: #d8c7bd; }
.feature-strip { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.feature-strip text { padding: 10rpx 16rpx; border: 2rpx solid #ddcec5; border-radius: 2rpx; color: #6e5851; background: #fffdfa; font-size: 21rpx; }
.compare-grid { display: flex; gap: 16rpx; margin-top: 20rpx; }
.compare-card { box-sizing: border-box; width: 50%; min-height: 260rpx; padding: 24rpx; border-radius: 26rpx; }
.leave-card { background: #e8f1f2; }
.delete-card { background: #f7e6e4; }
.compare-tag { font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; opacity: .66; }
.compare-title { margin-top: 14rpx; font-size: 29rpx; font-weight: 850; }
.compare-copy { margin-top: 13rpx; color: #6f6260; font-size: 21rpx; line-height: 1.65; }
.privacy-note { display: flex; gap: 20rpx; margin-top: 50rpx; padding: 28rpx; border: 2rpx solid #d8dfe0; border-radius: 6rpx; background: #edf3f3; }
.privacy-mark { flex: none; color: #35556a; font-size: 48rpx; line-height: 1; }
.privacy-title { color: #35556a; font-size: 27rpx; font-weight: 850; }
.privacy-copy { margin-top: 8rpx; color: #667376; font-size: 22rpx; line-height: 1.7; }
.faq-item { border-bottom: 2rpx solid #ded2ca; }
.faq-question { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 4rpx; font-size: 25rpx; font-weight: 750; }
.faq-question text:last-child { color: #c35d66; font-family: Georgia,serif; font-size: 36rpx; font-weight: 400; }
.faq-answer { padding: 0 44rpx 26rpx 4rpx; color: #776864; font-size: 22rpx; line-height: 1.75; }
.guide-footer { margin-top: 52rpx; color: #a18e84; font-size: 18rpx; letter-spacing: 3rpx; text-align: center; }
