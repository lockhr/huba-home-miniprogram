.progress-caption { margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }
.item-memory-hero { height: 390rpx; border: 2rpx solid rgba(255,255,255,.95); background: linear-gradient(135deg,#fff6fa,#f5f8ff); }
.item-memory-hero::after { z-index: 1; background: linear-gradient(90deg,rgba(255,246,250,.98) 0%,rgba(255,246,250,.92) 43%,rgba(255,246,250,.12) 100%); }
.item-memory-hero .item-memory-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .42; }
.item-memory-tint { position: absolute; z-index: 1; inset: 0; background: radial-gradient(circle at 18% 22%,rgba(255,255,255,.96),transparent 34%); }
.item-memory-copy { position: absolute; z-index: 3; left: 30rpx; top: 73rpx; width: 330rpx; color: var(--navy); }
.item-memory-copy>text:first-child { color: #d56d93; font-size: 17rpx; font-weight: 700; letter-spacing: 3rpx; }
.item-memory-copy>view { margin-top: 13rpx; font-size: 34rpx; font-weight: 850; line-height: 1.35; }
.item-memory-copy>text:last-child { display: block; margin-top: 18rpx; color: #8e96a5; font-size: 19rpx; }
.item-memory-frame { position: absolute; z-index: 3; right: 23rpx; top: 25rpx; width: 270rpx; height: 340rpx; padding: 9rpx; border: 4rpx solid rgba(255,255,255,.96); border-radius: 30rpx 30rpx 30rpx 10rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(91,57,77,.18); box-sizing: border-box; transform: rotate(1.2deg); }
.item-memory-frame .item-memory-photo { display: block; width: 100%; height: 100%; border-radius: 22rpx 22rpx 22rpx 7rpx; background: #e8eadf; object-position: center; }
.item-memory-frame>text { position: absolute; right: -11rpx; bottom: -11rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; color: #fff; background: #ff6c9e; box-shadow: 0 6rpx 16rpx rgba(255,76,139,.28); font-size: 25rpx; }
.item-memory-star { position: absolute; z-index: 4; left: 18rpx; bottom: 15rpx; color: rgba(255,76,139,.55); font-size: 25rpx; }

@media (max-width: 340px) {
  .item-memory-copy { width: 285rpx; }
  .item-memory-frame { right: 17rpx; width: 246rpx; }
}
