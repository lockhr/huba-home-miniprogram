@keyframes reminder-pop { 0%,100% { transform: scale(1); } 40% { transform: scale(1.16); } }
@keyframes reminder-rise { 0% { opacity: 0; transform: translateY(14rpx); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateY(-32rpx); } }
@media (prefers-reduced-motion: reduce) { .reminder-number-pop,.reminder-plus,.reminder-notice { animation: none; } }

