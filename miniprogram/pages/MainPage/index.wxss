.appearance-subtitle { margin-top: 8rpx; color: #8790a0; font-size: 20rpx; line-height: 1.5; }
.appearance-close { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-top: 4rpx; border: 2rpx solid rgba(235,218,227,.9); border-radius: 50%; color: #9a7887; background: rgba(255,255,255,.8); font-size: 42rpx; font-weight: 300; line-height: 1; }
.appearance-scroll { height: 68vh; }
.appearance-section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 16rpx; }
.appearance-section-title>text:first-child { color: var(--navy); font-size: 26rpx; font-weight: 820; }
.appearance-section-title>text:last-child { color: #a2919b; font-size: 18rpx; }
.appearance-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; }
.appearance-tile { position: relative; height: 196rpx; overflow: hidden; border: 3rpx solid rgba(255,255,255,.96); border-radius: 27rpx; background: #f4edf1; box-shadow: 0 10rpx 26rpx rgba(100,68,86,.12); transition: transform 140ms ease, opacity 140ms ease; }
.appearance-tile image { width: 100%; height: 100%; }
.appearance-tile-shade { position: absolute; inset: 0; background: linear-gradient(180deg,transparent 35%,rgba(39,37,48,.66) 100%); }
.appearance-tile-label { position: absolute; left: 16rpx; right: 12rpx; bottom: 14rpx; display: flex; align-items: center; color: #fff; }
.appearance-tile-label>text { margin-right: 9rpx; font-size: 30rpx; }
.appearance-tile-label>view { display: flex; min-width: 0; flex-direction: column; }
.appearance-tile-label>view>text:first-child { font-size: 22rpx; font-weight: 800; }
.appearance-tile-label>view>text:last-child { margin-top: 2rpx; color: rgba(255,255,255,.76); font-size: 16rpx; }
.appearance-reset { position: absolute; right: 10rpx; top: 10rpx; padding: 7rpx 11rpx; border: 2rpx solid rgba(255,255,255,.68); border-radius: 15rpx; color: #fff; background: rgba(47,41,49,.44); font-size: 15rpx; }
.appearance-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(50,42,50,.62); font-size: 22rpx; font-weight: 750; }
.appearance-tile-pressed { opacity: .86; transform: scale(.975); }
.page-theme-title { margin-top: 30rpx; }
.appearance-tile-wide { grid-column: 1 / -1; }
.avatar-section-title { margin-top: 30rpx; }
.avatar-custom-card { display: flex; align-items: center; justify-content: center; min-height: 220rpx; padding: 24rpx 30rpx; border: 2rpx solid rgba(218,235,225,.96); border-radius: 30rpx; background: linear-gradient(125deg,rgba(255,241,247,.92),rgba(255,255,255,.96) 50%,rgba(237,250,242,.96)); box-sizing: border-box; }
.avatar-custom-person { display: flex; align-items: center; min-width: 170rpx; flex-direction: column; }
.avatar-custom-frame { position: relative; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border: 6rpx solid #fff; border-radius: 38rpx; box-shadow: 0 10rpx 28rpx rgba(105,75,91,.16); background: #fff2f7; font-size: 58rpx; transition: transform 140ms ease; }
.avatar-custom-frame image { width: 100%; height: 100%; border-radius: 32rpx; }
.partner-frame { background: #effbf3; }
.avatar-camera { position: absolute; right: -12rpx; bottom: -9rpx; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border: 4rpx solid #fff; border-radius: 50%; background: #ee8db0; box-shadow: 0 5rpx 12rpx rgba(174,76,112,.2); font-size: 22rpx; }
.avatar-loading { position: absolute; inset: -2rpx; display: flex; align-items: center; justify-content: center; border-radius: 34rpx; color: #fff; background: rgba(58,48,58,.65); font-size: 18rpx; font-weight: 750; }
.avatar-frame-pressed { transform: scale(.94); }
.avatar-custom-name { margin-top: 14rpx; color: var(--navy); font-size: 21rpx; font-weight: 780; }
.avatar-reset,.avatar-partner-note { min-height: 34rpx; margin-top: 5rpx; color: #c26788; font-size: 17rpx; }
.avatar-partner-note { color: #8e9a91; }
.avatar-heart-line { display: flex; align-items: center; width: 120rpx; margin: 0 12rpx; flex-direction: column; color: #ef88ad; font-size: 33rpx; }
.avatar-heart-line view { width: 88rpx; height: 2rpx; margin-top: 5rpx; background: linear-gradient(90deg,transparent,#efabc2,transparent); }
.appearance-privacy { margin: 20rpx 0 0; color: #95909a; font-size: 18rpx; line-height: 1.6; text-align: center; }
.appearance-safe-bottom { height: calc(38rpx + env(safe-area-inset-bottom)); }
@keyframes appearance-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes appearance-sheet-up { from { opacity: .7; transform: translateY(60rpx); } to { opacity: 1; transform: translateY(0); } }

@media (max-width: 340px) {
  .anniversary-card { padding-right: 180rpx; }
  .anniversary-illustration { width: 188rpx; height: 188rpx; }
  .anniversary-eyebrow { width: 390rpx; }
  .mood-note { display: none; }
  .feature-card { min-height: 260rpx; }
  .space-entry-note { max-width: 330rpx; }
  .space-entry-chip { padding-right: 9rpx; padding-left: 9rpx; font-size: 15rpx; }
  .appearance-sheet { padding-right: 20rpx; padding-left: 20rpx; }
  .appearance-tile { height: 174rpx; }
  .avatar-heart-line { width: 80rpx; margin-right: 4rpx; margin-left: 4rpx; }
}

@media (prefers-reduced-motion: reduce) { .appearance-overlay,.appearance-sheet { animation: none; } }
