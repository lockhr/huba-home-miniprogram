.reminder-notice { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid #deeddf; color: #287044; font-size: 23rpx; line-height: 1.6; animation: page-in 250ms ease-out both; }
