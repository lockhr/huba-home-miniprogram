.reminder-add-pressed { transform: scale(.98); }
.reminder-help { margin-top: 15rpx; text-align: center; color: #796e7c; font-size: 22rpx; line-height: 1.6; }
.reminder-footnote { margin-top: 5rpx; text-align: center; color: #97939c; font-size: 19rpx; line-height: 1.6; }
