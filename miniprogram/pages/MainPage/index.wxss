.reminder-plus { position: absolute; left: 90rpx; top: 2rpx; color: #d6447a; font-size: 28rpx; font-weight: 700; animation: reminder-rise 850ms ease-out both; pointer-events: none; }
.reminder-number-pop { animation: reminder-pop 450ms ease-out; }
.reminder-add { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 82rpx; margin: 0; padding: 15rpx 22rpx; box-sizing: border-box; border-radius: 22rpx; color: #fff; background: #e96996; font-size: 27rpx; font-weight: 700; line-height: 1.5; transition: transform 140ms ease; }
