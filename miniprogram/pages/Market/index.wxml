<wxs module="util" src="../util.wxs" />
<view class="ux-page page-shell market-page">
  <page-heading title="胡巴家长们" subtitle="和你一起，把每一天变得更好 ♡" />
  <view class="content-wrap">
    <view class="wallet-card" wx:if="{{user}}">
      <view class="wallet-avatar"><image src="{{profileAvatar}}" mode="aspectFit" /><text>{{user}}</text></view>
      <view class="wallet-copy"><view><text class="wallet-name">{{user}}的小金库</text><text class="wallet-tag">HUBA MEMBER</text></view><text>和{{partner}}一起，把心愿慢慢实现 ♡</text></view>
      <view class="wallet-balance"><text>可用积分</text><view><text>💰</text><text>{{credit}}</text></view></view>
      <text class="wallet-sparkle wallet-sparkle-one">✦</text><text class="wallet-sparkle wallet-sparkle-two">♡</text>
    </view>
    <view class="search-card"><text class="search-icon-text">⌕</text><input class="search-input" placeholder="搜索商品" placeholder-class="search-placeholder" bindinput="onSearch" value="{{search}}" /><button wx:if="{{search}}" class="search-clear" bindtap="clearSearch" aria-label="清除搜索" hover-class="ux-pressed">×</button></view>
    <feedback-state loading="{{loading}}" error="{{loadError}}" label="正在读取商品…" bind:retry="loadData" />
    <view wx:if="{{loaded}}" class="list-help">左滑条目可兑换、星标或删除</view>
    <view class="market-window"><image class="window-photo" src="{{appearance.market}}" mode="aspectFill" /><view class="window-shade"></view><view class="window-sign"><text>HUBA</text><text>小小心愿商店</text></view><view class="window-shelves"><view>🎁</view><view>🧸</view><view>🎟️</view></view><view class="window-copy">把想要的写下来<br/><text>让积分兑换成快乐 ♡</text></view><text class="window-star">✦</text></view>

    <view class="section-block">
      <view class="section-heading"><view class="heading-left"><text class="heading-icon">🛍️</text><text>心愿货架</text><text class="count-badge">{{unboughtItems.length}}</text></view><text class="section-action">可以兑换</text></view>
      <view class="list-card" wx:if="{{unboughtItems.length > 0}}">
        <view class="form-cell" wx:for="{{unboughtItems}}" wx:key="_id">
          <mp-slideview buttons="{{slideButtons}}" data-index="{{index}}" ext-class="huba-actions" icon="{{false}}" disable="{{actionBusy}}" duration="{{220}}" bindbuttontap="slideButtonTapUpper">
            <view class="list-row" data-index="{{index}}" bindtap="toDetailPageUpper" hover-class="ux-pressed" hover-stay-time="80">
              <view class="product-thumb thumb-tone-{{index % 3}}"><image wx:if="{{index % 3 === 0}}" src="../../images/brand/mascot-pair.png" mode="aspectFit" /><image wx:elif="{{index % 3 === 1}}" src="../../images/brand/decor-letter.png" mode="aspectFit" /><image wx:else src="../../images/brand/decor-calendar.png" mode="aspectFit" /></view>
              <view class="row-copy"><view class="product-kicker">{{index % 2 ? '甜甜心愿' : '胡巴精选'}} · 可兑换</view><view class="row-title">{{util.filterStr(item.title, 12)}}</view><view class="product-meta"><text>💰 {{util.filterStr(item.credit, 10)}} 积分</text><text>📅 {{util.cutStr(item.date, 10)}}</text></view></view>
              <text class="row-arrow">›</text><text wx:if="{{item.star}}" class="star-mark">★</text>
            </view>
          </mp-slideview>
        </view>
      </view>
    </view>

    <view class="section-block">
      <view class="section-heading"><view class="heading-left"><text class="heading-icon">💌</text><text>已被兑换</text><text class="count-badge">{{boughtItems.length}}</text></view><text class="section-action">幸福留档</text></view>
      <view class="list-card" wx:if="{{boughtItems.length > 0}}">
        <view class="form-cell" wx:for="{{boughtItems}}" wx:key="_id">
          <mp-slideview buttons="{{slideButtons}}" data-index="{{index}}" ext-class="huba-actions" icon="{{false}}" disable="{{actionBusy}}" duration="{{220}}" bindbuttontap="slideButtonTapLower">
            <view class="list-row sold-row" data-index="{{index}}" bindtap="toDetailPageLower" hover-class="ux-pressed" hover-stay-time="80">
              <view class="product-thumb thumb-tone-{{index % 3}}"><image wx:if="{{index % 2 === 0}}" src="../../images/brand/decor-diary.png" mode="aspectFit" /><image wx:else src="../../images/brand/mascot-pair.png" mode="aspectFit" /></view>
              <view class="row-copy"><view class="product-kicker sold-kicker">兑换完成 · 等待使用</view><view class="row-title">{{util.filterStr(item.title, 12)}}</view><view class="product-meta"><text>💰 {{util.filterStr(item.credit, 10)}} 积分</text><text>📅 {{util.cutStr(item.date, 10)}}</text></view></view>
              <text class="row-arrow">›</text><text wx:if="{{item.star}}" class="star-mark">★</text>
            </view>
          </mp-slideview>
        </view>
      </view>
    </view>
    <view class="soft-card empty-card" wx:if="{{!loading && !loadError && unboughtItems.length === 0 && boughtItems.length === 0}}"><image class="empty-image" src="../../images/brand/empty-storage.png" mode="aspectFit" /><view class="empty-title">{{search ? '没有找到匹配的商品' : '货架还空着呢'}}</view><view class="empty-subtitle">{{search ? '试试更短的关键词，或点搜索框右侧清除' : '添加一件能让彼此开心的小奖励吧 ♡'}}</view></view>
  </view>
</view>

<view class="create-action-capsule" hover-class="create-action-active" role="button" aria-label="新增商品" bindtap="toAddPage"><view class="create-action-icon">＋</view><view class="create-action-copy"><text class="create-action-label">上架</text><text>写下想兑换的小美好</text></view></view>

<xiaoba-orb />
