.market-page { animation: page-in 360ms ease-out both; }
.form-cell { padding: 0; }
.wallet-card { position: relative; display: grid; grid-template-columns: 82rpx minmax(0,1fr) auto; align-items: center; min-height: 126rpx; margin-top: 4rpx; padding: 20rpx 24rpx; overflow: hidden; border: 2rpx solid rgba(255,225,235,.96); border-radius: 28rpx; background: radial-gradient(circle at 88% 18%,rgba(255,207,224,.72),transparent 38%),linear-gradient(130deg,rgba(255,255,255,.98),rgba(255,241,247,.94)); box-shadow: 0 9rpx 24rpx rgba(223,143,174,.13); box-sizing: border-box; }
.wallet-avatar { position: relative; display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border: 4rpx solid #fff; border-radius: 24rpx; background: #ffeaf2; box-shadow: 0 7rpx 17rpx rgba(173,79,116,.13); }.wallet-avatar image { width: 68rpx; height: 68rpx; }.wallet-avatar>text { position: absolute; right: -6rpx; bottom: -7rpx; display: flex; align-items: center; justify-content: center; width: 29rpx; height: 29rpx; border: 3rpx solid #fff; border-radius: 50%; color: #fff; background: var(--pink); font-size: 16rpx; font-weight: 800; }
.wallet-copy { position: relative; z-index: 2; min-width: 0; }.wallet-copy>view { display: flex; align-items: center; gap: 9rpx; }.wallet-name { color: var(--navy); font-size: 25rpx; font-weight: 850; }.wallet-tag { padding: 4rpx 7rpx; border-radius: 9rpx; color: #d2618b; background: #ffe4ee; font-size: 13rpx; letter-spacing: 1rpx; }.wallet-copy>text { display: block; margin-top: 6rpx; overflow: hidden; color: #8795a8; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.wallet-balance { position: relative; z-index: 2; display: flex; align-items: flex-end; flex-direction: column; margin-left: 16rpx; }.wallet-balance>text { color: #9a8c96; font-size: 16rpx; }.wallet-balance>view { display: flex; align-items: baseline; margin-top: 2rpx; color: #c58b27; }.wallet-balance>view text:first-child { margin-right: 5rpx; font-size: 22rpx; }.wallet-balance>view text:last-child { font-size: 35rpx; font-weight: 900; }
.wallet-sparkle { position: absolute; color: rgba(255,86,145,.26); }.wallet-sparkle-one { right: 12rpx; top: 7rpx; font-size: 21rpx; }.wallet-sparkle-two { left: 7rpx; bottom: 1rpx; font-size: 22rpx; }
.market-window { position: relative; display: flex; align-items: flex-end; min-height: 188rpx; margin-top: 22rpx; padding: 22rpx 24rpx; overflow: hidden; border: 2rpx solid rgba(255,225,235,.96); border-radius: 30rpx; background: linear-gradient(145deg,#fff7fa,#fff 54%,#fff3db); box-shadow: var(--shadow); box-sizing: border-box; }.window-sign { position: absolute; top: 16rpx; left: 24rpx; display: flex; align-items: baseline; gap: 10rpx; }.window-sign text:first-child { padding: 5rpx 10rpx; border-radius: 10rpx; color: #fff; background: var(--pink); font-size: 15rpx; letter-spacing: 2rpx; }.window-sign text:last-child { color: var(--navy); font-size: 25rpx; font-weight: 850; }.window-shelves { display: flex; gap: 9rpx; }.window-shelves view { display: flex; align-items: center; justify-content: center; width: 75rpx; height: 82rpx; border: 3rpx solid rgba(255,255,255,.92); border-radius: 21rpx 21rpx 10rpx 10rpx; background: linear-gradient(160deg,#fff,#ffe9f1); box-shadow: 0 8rpx 15rpx rgba(154,101,123,.09); font-size: 38rpx; }.window-copy { margin-left: 22rpx; color: #63768c; font-size: 24rpx; font-weight: 750; line-height: 1.5; }.window-copy text { color: #d16a90; font-size: 19rpx; font-weight: 400; }.window-star { position: absolute; right: 16rpx; top: 9rpx; color: #ffd066; font-size: 30rpx; }
.product-thumb { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 96rpx; margin-right: 20rpx; overflow: hidden; border-radius: 22rpx; background: linear-gradient(145deg,#fff8fb,#ffe7f0); }
.product-thumb image { width: 112rpx; height: 92rpx; }
.thumb-tone-1 { background: linear-gradient(145deg,#fff8fb,#eefbf2); }.thumb-tone-2 { background: linear-gradient(145deg,#fffaf1,#fff0d3); }
.product-kicker { margin-bottom: 2rpx; color: #d46d94; font-size: 17rpx; letter-spacing: 1rpx; }.sold-kicker { color: #9a8f99; }.product-meta { display: flex; gap: 16rpx; margin-top: 7rpx; color: #8a99aa; font-size: 19rpx; }.product-meta text:first-child { color: #c88b24; font-weight: 700; }
.sold-row { opacity: .78; }
.buyBtn .weui-slideview__btn { background: #91d9a1; }
.starBtn .weui-slideview__btn { background: #ffd66b; }
.removeBtn .weui-slideview__btn { background: #ff8f9f; }
.window-photo,.window-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.window-photo { opacity: .34; }
.window-shade { background: linear-gradient(90deg,rgba(255,250,252,.97) 0%,rgba(255,250,252,.88) 55%,rgba(255,241,246,.54) 100%); }
.window-sign,.window-shelves,.window-copy,.window-star { z-index: 2; }
