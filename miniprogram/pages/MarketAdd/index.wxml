<wxs module="util" src="../util.wxs" />
<view class="ux-page subpage-shell">
  <view class="subpage-hero"><image src="{{appearance.market}}" mode="aspectFill" /><view class="subpage-hero-title">准备一份小小的惊喜</view></view>
  <view class="form-group">
    <view class="form-cell"><view class="form-cell_title">🌟 选择预设</view><picker mode="selector" bindchange="onPresetChange" value="{{presetIndex}}" range="{{presets}}" range-key="name" disabled="{{saving}}"><view class="picker-value">{{presets[presetIndex].name}} <text>›</text></view></picker></view>
    <view class="form-cell"><view class="form-cell_title">📌 商品名称</view><input class="form-cell_input" placeholder="商品名是什么？" placeholder-class="form-cell_placeholder" bindinput="onTitleInput" value="{{title}}" disabled="{{saving}}" /></view>
    <view class="form-cell"><view class="form-cell_title">📝 商品详情</view><textarea class="form-cell_input" placeholder="这份奖励可以做什么呢？" placeholder-class="form-cell_placeholder" bindinput="onDescInput" value="{{desc}}" disabled="{{saving}}" /></view>
    <view class="form-cell"><view class="form-cell_title">💰 积分价格</view><slider min="0" max="{{maxCredit}}" block-size="18" block-color="#ff4c8b" backgroundColor="#ffe7f0" activeColor="#ff6d9c" bindchange="onCreditInput" value="{{credit}}" show-value disabled="{{saving}}" /></view>
  </view>
  <view class="footer"><view class="reset" bindtap="resetItem" hover-class="ux-pressed" hover-stay-time="80">重置</view><view class="save {{saving ? 'disabled' : ''}}" aria-disabled="{{saving}}" bindtap="saveItem" hover-class="ux-pressed" hover-stay-time="80">{{saving ? '正在上架…' : '上架商品'}}</view></view>
</view>

<xiaoba-orb />
