.mission-page { animation: page-in 360ms ease-out both; }
.mission-hero { height: 250rpx; }
.mission-calendar { margin-top: 22rpx; padding: 25rpx 24rpx 20rpx; border: 2rpx solid #f7e2ea; border-radius: 30rpx; background: #fff; box-shadow: var(--shadow); }
.calendar-header { display: flex; align-items: center; justify-content: space-between; }.calendar-kicker { color: #cb7896; font-size: 16rpx; font-weight: 700; letter-spacing: 2rpx; }.calendar-title { margin-top: 4rpx; color: var(--navy); font-size: 29rpx; font-weight: 850; }.calendar-arrows { display: flex; gap: 12rpx; }.calendar-arrows view { display: flex; align-items: center; justify-content: center; width: 51rpx; height: 51rpx; border-radius: 17rpx; color: #be5b82; background: #fff1f6; font-size: 38rpx; line-height: 1; }
.calendar-weekdays,.calendar-grid { display: grid; grid-template-columns: repeat(7,1fr); text-align: center; }.calendar-weekdays { margin-top: 22rpx; color: #98a2b2; font-size: 19rpx; }.calendar-grid { margin-top: 8rpx; row-gap: 7rpx; }.calendar-day { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 66rpx; border-radius: 18rpx; color: #3a4b63; font-size: 25rpx; font-weight: 700; }.calendar-day.outside { color: #b9c0cc; }.calendar-day.selected { color: #fff; background: #ff4c8b; box-shadow: 0 8rpx 20rpx rgba(255,76,139,.25); }.calendar-dot { position: absolute; bottom: 5rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #ff6c9f; }.calendar-day.selected .calendar-dot { background: #fff; }
.calendar-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; padding-top: 15rpx; border-top: 2rpx solid #f9edf1; color: #8b97aa; font-size: 19rpx; }.all-task-chip { padding: 9rpx 17rpx; border-radius: 18rpx; color: #c56086; background: #fff2f7; font-weight: 750; }.all-task-chip.active { color: #fff; background: #e96191; }
.form-cell { padding: 0; }
.mission-overview { position: relative; display: flex; align-items: center; min-height: 176rpx; margin-top: 22rpx; padding: 24rpx 25rpx; overflow: hidden; border: 2rpx solid rgba(255,226,235,.95); border-radius: 30rpx; background: radial-gradient(circle at 87% 12%,rgba(255,205,222,.7),transparent 32%),linear-gradient(130deg,#fff,#fff2f7); box-shadow: var(--shadow); box-sizing: border-box; }
.overview-copy { min-width: 0; flex: 1; }.overview-eyebrow { color: #d26990; font-size: 16rpx; letter-spacing: 2rpx; }.overview-title { margin-top: 4rpx; color: var(--navy); font-size: 29rpx; font-weight: 850; }.overview-note { width: 350rpx; margin-top: 9rpx; color: #8492a3; font-size: 19rpx; line-height: 1.45; }
.overview-stats { display: flex; gap: 10rpx; }.overview-stats view { display: flex; align-items: center; flex-direction: column; justify-content: center; width: 94rpx; height: 110rpx; border-radius: 24rpx; background: rgba(255,255,255,.78); box-shadow: 0 7rpx 18rpx rgba(120,80,98,.07); }.overview-stats view>text:first-child { font-size: 27rpx; }.overview-stats view>text:nth-child(2) { color: var(--pink); font-size: 28rpx; font-weight: 850; }.overview-stats view>text:last-child { color: #8694a6; font-size: 16rpx; }.overview-sparkle { position: absolute; left: 8rpx; bottom: 4rpx; color: #ff8eb3; font-size: 24rpx; }
.task-ticket { min-height: 148rpx; padding-left: 36rpx; border-left: 8rpx solid #ff87ac; }.task-ticket.task-tone-1 { border-left-color: #7bcf9a; }.task-ticket.task-tone-2 { border-left-color: #ffd069; }.task-ticket::before,.task-ticket::after { position: absolute; left: -13rpx; width: 22rpx; height: 22rpx; border-radius: 50%; content: ''; background: #fff8fb; }.task-ticket::before { top: 20rpx; }.task-ticket::after { bottom: 20rpx; }
.task-owner { margin-bottom: 3rpx; color: #bb6b8a; font-size: 18rpx; letter-spacing: 1rpx; }.task-meta-line { display: flex; gap: 18rpx; margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.task-credit { color: #c78b24; font-weight: 700; }.task-pin { position: absolute; right: 22rpx; top: 13rpx; z-index: 3; color: #ff72a2; font-size: 24rpx; transform: rotate(9deg); }
.completed-row { opacity: .74; filter: saturate(.76); }
.markBtn .weui-slideview__btn { background: #91d9a1; }
.starBtn .weui-slideview__btn { background: #ffd66b; }
.removeBtn .weui-slideview__btn { background: #ff8f9f; }
