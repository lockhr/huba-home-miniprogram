<wxs module="util" src="../util.wxs" />
<view class="ux-page subpage-shell">
  <view class="subpage-hero mission-memory-hero">
    <image class="mission-memory-backdrop" src="{{appearance.mission}}" mode="aspectFill" />
    <view class="mission-memory-tint"></view>
    <view class="mission-memory-frame"><image class="mission-memory-photo" src="../../images/brand/mascot-pair.png" mode="aspectFit" /><text>✿</text></view>
    <view class="mission-memory-copy"><text>TODAY'S LITTLE PLAN</text><view>写下今天的<br/>小目标</view><text>把小事一件件完成 ♡</text></view>
    <text class="mission-memory-star">✦</text>
  </view>
  <view class="form-group">
    <view class="form-cell"><view class="form-cell_title">🌟 选择预设</view><picker mode="selector" bindchange="onPresetChange" value="{{presetIndex}}" range="{{presets}}" range-key="name" disabled="{{saving}}"><view class="picker-value">{{presets[presetIndex].name}} <text>›</text></view></picker></view>
    <view class="form-cell"><view class="form-cell_title">📌 任务名称</view><input class="form-cell_input" placeholder="任务名是什么？" placeholder-class="form-cell_placeholder" bindinput="onTitleInput" value="{{title}}" disabled="{{saving}}" /></view>
    <view class="form-cell"><view class="form-cell_title">📝 任务详情</view><textarea class="form-cell_input" placeholder="一起写清楚要完成的小事吧" placeholder-class="form-cell_placeholder" bindinput="onDescInput" value="{{desc}}" disabled="{{saving}}" /></view>
    <view class="form-cell"><view class="form-cell_title">💰 积分奖励</view><slider min="0" max="{{maxCredit}}" block-size="18" block-color="#ff4c8b" backgroundColor="#ffe7f0" activeColor="#ff6d9c" bindchange="onCreditInput" value="{{credit}}" show-value disabled="{{saving}}" /></view>
    <view class="form-cell"><view class="form-cell_title">🗓️ 计划日期（可留空）</view><picker mode="date" value="{{planDate}}" bindchange="setPlanDate" disabled="{{saving}}"><view class="picker-value">{{planDate || '选择哪天一起完成'}} <text>›</text></view></picker><view wx:if="{{planDate}}" class="clear-plan-date" bindtap="clearPlanDate" hover-class="ux-pressed" hover-stay-time="80">清除计划日期</view></view>
  </view>
  <view class="footer"><view class="reset" bindtap="resetMission" hover-class="ux-pressed" hover-stay-time="80">重置</view><view class="save {{saving ? 'disabled' : ''}}" aria-disabled="{{saving}}" bindtap="handleTap" hover-class="ux-pressed" hover-stay-time="80">{{saving ? '正在保存…' : '保存任务'}}</view></view>
</view>

<xiaoba-orb />
