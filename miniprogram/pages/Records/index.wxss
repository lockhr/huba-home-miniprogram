.record-add { z-index: 74; }
.editor-mask { position: fixed; z-index: 2000; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; background: rgba(28,33,45,.34); transition: padding-bottom 120ms ease-out; animation: mask-in 180ms ease-out both; }.editor-sheet { display: flex; flex-direction: column; width: 100%; height: 690rpx; max-height: calc(100vh - 20rpx); padding: 12rpx 28rpx 0; overflow: hidden; box-sizing: border-box; border-radius: 38rpx 38rpx 0 0; background: linear-gradient(180deg,#fff,#fff7fa); box-shadow: 0 -12rpx 40rpx rgba(55,37,46,.16); animation: sheet-up 240ms ease-out both; }.sheet-handle { flex: none; width: 72rpx; height: 8rpx; margin: 0 auto 18rpx; border-radius: 5rpx; background: #e7dce2; }.sheet-title { display: flex; align-items: center; justify-content: space-between; flex: none; color: var(--navy); font-size: 29rpx; font-weight: 850; }.sheet-title>view text { margin-right: 8rpx; }.sheet-title>text { padding: 0 5rpx 5rpx 25rpx; color: #9aa5b1; font-size: 38rpx; font-weight: 300; }.editor-scroll { min-height: 0; flex: 1; margin-top: 8rpx; }.editor-scroll-content { padding: 0 2rpx 18rpx; }.editor-scroll textarea,.editor-scroll input { box-sizing: border-box; width: 100%; padding: 18rpx 20rpx; border-radius: 22rpx; color: var(--navy); background: #fff2f7; font-size: 24rpx; }.post-editor .editor-scroll textarea { height: 165rpx; margin-top: 9rpx; }.editor-placeholder { color: #b4bdc8; }.editor-count { margin: 5rpx 6rpx 10rpx; color: #a1aab5; font-size: 17rpx; text-align: right; }.post-photo-picker { display: flex; align-items: center; justify-content: center; height: 170rpx; overflow: hidden; border: 2rpx dashed #f1cbd9; border-radius: 23rpx; color: #738398; background: rgba(255,255,255,.75); text-align: center; }.post-photo-picker>image { width: 100%; height: 100%; background: #f8eef2; }.post-photo-picker>view>text:first-child { font-size: 37rpx; }.post-photo-picker>view>view { font-size: 22rpx; }.photo-picker-note { display: block; margin-top: 3rpx; color: #a7b0bb; font-size: 16rpx !important; }.remove-editor-photo { margin-top: 8rpx; color: #cf668c; font-size: 18rpx; text-align: right; }.sheet-actions { flex: none; margin: 0 -28rpx; padding: 12rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid rgba(241,221,229,.72); background: rgba(255,250,252,.98); box-shadow: 0 -8rpx 22rpx rgba(93,57,75,.06); }.sheet-save { display: flex; align-items: center; justify-content: center; height: 82rpx; border-radius: 42rpx; color: #fff; background: linear-gradient(135deg,#ff72a4,#ff3e83); box-shadow: 0 10rpx 24rpx rgba(255,76,139,.22); font-size: 25rpx; font-weight: 850; }.sheet-save.disabled { opacity: .55; }
.wish-editor { height: 720rpx; }.input-label { margin: 18rpx 4rpx 8rpx; color: #596d83; font-size: 20rpx; font-weight: 750; }.input-label.first-label { margin-top: 7rpx; }.icon-picker { display: flex; justify-content: space-between; }.icon-picker>view { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border: 2rpx solid #f0e5ea; border-radius: 19rpx; background: #fff; font-size: 31rpx; }.icon-picker>view.active { border-color: #ff79a6; background: #ffe9f1; box-shadow: 0 6rpx 14rpx rgba(255,76,139,.14); transform: translateY(-3rpx); }.wish-editor input { height: 70rpx; }.wish-note-input { height: 108rpx; }
.wish-photo-picker { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 180rpx; overflow: hidden; border: 2rpx dashed #f0cddd; border-radius: 20rpx; color: #b96b89; background: #fff8fb; }.wish-photo-picker image { width: 100%; height: 100%; }.wish-photo-picker>view { display: flex; align-items: center; gap: 10rpx; font-size: 23rpx; }.wish-photo-picker>view>text:first-child { font-size: 35rpx; }.wish-photo { position: relative; width: 100%; height: 230rpx; margin-top: 14rpx; overflow: hidden; border-radius: 18rpx; background: #f7edf2; }.wish-photo image { width: 100%; height: 100%; }.wish-photo text { position: absolute; right: 12rpx; bottom: 10rpx; padding: 5rpx 12rpx; border-radius: 15rpx; color: #fff; background: rgba(30,43,60,.56); font-size: 17rpx; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } } @keyframes sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
@media (max-width: 340px) { .hero-copy { left: 24rpx; width: 290rpx; }.hero-title { font-size: 34rpx; }.hero-note { max-width: 270rpx; font-size: 18rpx; }.hero-memory-frame { right: 16rpx; width: 245rpx; }.hero-memory-photo { width: 225rpx; }.hero-stamp { right: 196rpx; }.switch-item { padding-right: 8rpx; padding-left: 8rpx; }.switch-item>view { font-size: 22rpx; }.post-keepsake { display: none; }.wish-note { max-width: 310rpx; } }

