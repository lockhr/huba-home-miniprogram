.records-page { animation: page-in 360ms ease-out both; }
.records-content { padding-bottom: 58rpx; }
.records-hero { position: relative; height: 270rpx; overflow: hidden; border: 2rpx solid rgba(255,255,255,.96); border-radius: 34rpx; background: radial-gradient(circle at 10% 10%,rgba(255,255,255,.96) 0 7%,transparent 24%),linear-gradient(135deg,#fff8fb 0%,#ffeaf2 55%,#f3e8f6 100%); box-shadow: var(--shadow); }
.records-hero::before { position: absolute; right: 245rpx; bottom: -45rpx; width: 180rpx; height: 180rpx; border-radius: 50%; content: ''; background: rgba(255,255,255,.42); }
.records-hero::after { position: absolute; top: 22rpx; left: 22rpx; width: 22rpx; height: 22rpx; border-radius: 50%; content: ''; background: #ffd3e2; box-shadow: 36rpx 15rpx 0 -5rpx #f8d5a4,78rpx -5rpx 0 -7rpx #c6e8df; }
.hero-copy { position: absolute; z-index: 3; left: 30rpx; top: 58rpx; width: 330rpx; }.hero-kicker,.section-eyebrow { color: #ce6b90; font-size: 16rpx; letter-spacing: 3rpx; }.hero-title { margin-top: 8rpx; color: var(--navy); font-size: 39rpx; font-weight: 850; }.hero-note { max-width: 315rpx; margin-top: 10rpx; color: #6e7e91; font-size: 20rpx; line-height: 1.5; }
.hero-memory-frame { position: absolute; z-index: 2; top: 28rpx; right: 24rpx; width: 280rpx; padding: 10rpx 10rpx 26rpx; box-sizing: border-box; border-radius: 23rpx; background: rgba(255,255,255,.94); box-shadow: 0 13rpx 30rpx rgba(125,69,92,.17); transform: rotate(2.5deg); }
.hero-memory-photo { display: block; width: 260rpx; height: 145rpx; border-radius: 16rpx; background: #eef1ec; }
.hero-photo-label { margin-top: 8rpx; color: #c07d98; font-family: "STKaiti","KaiTi",serif; font-size: 14rpx; letter-spacing: 2rpx; text-align: center; }
.hero-stamp { position: absolute; z-index: 4; right: 225rpx; bottom: 18rpx; display: flex; align-items: center; justify-content: center; width: 108rpx; height: 55rpx; border: 2rpx solid rgba(255,255,255,.9); border-radius: 30rpx; color: #fff; background: linear-gradient(135deg,#ff91b5,#ff5f96); box-shadow: 0 8rpx 20rpx rgba(141,70,96,.14); font-size: 20rpx; font-weight: 800; transform: rotate(-5deg); }.hero-stamp text { margin: 0 5rpx; }.hero-sparkle { position: absolute; z-index: 4; color: #fff; text-shadow: 0 2rpx 8rpx rgba(255,76,139,.2); }.sparkle-a { right: 30rpx; top: 18rpx; font-size: 30rpx; }.sparkle-b { right: 325rpx; bottom: 27rpx; color: #f8a6c1; font-size: 23rpx; }
.section-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 20rpx; padding: 10rpx; border: 2rpx solid #f1e7ec; border-radius: 30rpx; background: rgba(255,255,255,.92); box-shadow: 0 9rpx 24rpx rgba(119,77,97,.08); }.switch-item { position: relative; display: grid; grid-template-columns: 52rpx 1fr; grid-template-rows: auto auto; align-items: center; min-height: 82rpx; padding: 8rpx 16rpx; box-sizing: border-box; border-radius: 22rpx; color: #7d8999; }.switch-item>text:first-child { grid-row: 1 / 3; font-size: 35rpx; }.switch-item>view { font-size: 25rpx; font-weight: 800; }.switch-sub { font-size: 17rpx; }.switch-item.active { color: #d94c81; background: linear-gradient(135deg,#fff1f6,#ffe5ef); box-shadow: 0 6rpx 15rpx rgba(255,76,139,.12); }
.world-heading,.wish-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 30rpx 8rpx 15rpx; }.world-heading>text { font-size: 35rpx; }.section-title { margin-top: 3rpx; color: var(--navy); font-size: 29rpx; font-weight: 850; }.wish-heading>text { max-width: 280rpx; color: #a37a8c; font-size: 18rpx; line-height: 1.45; text-align: right; }
.post-list { display: flex; flex-direction: column; gap: 16rpx; }.post-card { position: relative; padding: 24rpx; overflow: hidden; border: 2rpx solid #f2e7ec; border-radius: 30rpx; background: rgba(255,255,255,.96); box-shadow: 0 10rpx 25rpx rgba(112,72,91,.08); }.post-card::before { position: absolute; top: 0; bottom: 0; left: 0; width: 7rpx; content: ''; background: #ff82aa; }.post-card.tone-1::before { background: #86c9e4; }.post-card.tone-2::before { background: #ffd06c; }
.post-top { display: flex; align-items: center; }.post-avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; color: #fff; background: linear-gradient(145deg,#ff8bb2,#ff5d94); font-size: 30rpx; font-weight: 850; box-shadow: 0 7rpx 16rpx rgba(255,76,139,.2); }.tone-1 .post-avatar { background: linear-gradient(145deg,#8ad7eb,#66b9dc); }.tone-2 .post-avatar { background: linear-gradient(145deg,#ffd774,#eab94f); }.post-author { min-width: 0; flex: 1; margin-left: 15rpx; }.post-author>view { color: var(--navy); font-size: 26rpx; font-weight: 800; }.post-author>view text { color: var(--pink); }.post-author>text { display: block; margin-top: 3rpx; color: #a1acb9; font-size: 18rpx; }.post-menu { padding: 15rpx 2rpx 15rpx 24rpx; color: #7f8c9e; font-size: 25rpx; letter-spacing: 2rpx; }
.post-content { padding: 20rpx 2rpx 17rpx; color: #263d55; font-size: 26rpx; line-height: 1.72; white-space: pre-wrap; }.post-media { position: relative; height: 430rpx; margin-bottom: 16rpx; overflow: hidden; border-radius: 24rpx; background: #f7edf2; }.post-image-blur { position: absolute; inset: -24rpx; width: calc(100% + 48rpx); height: calc(100% + 48rpx); opacity: .48; filter: blur(22rpx) saturate(.72); }.post-image { position: relative; z-index: 2; display: block; width: 100%; height: 100%; }.post-image-tip { position: absolute; z-index: 3; right: 14rpx; bottom: 12rpx; padding: 6rpx 12rpx; border: 1rpx solid rgba(255,255,255,.68); border-radius: 18rpx; color: #fff; background: rgba(25,42,59,.43); font-size: 15rpx; backdrop-filter: blur(8rpx); }.comment-list { margin: 4rpx 0 14rpx; padding: 14rpx 16rpx; border-radius: 18rpx; color: #5f7186; background: #fff5f8; font-size: 20rpx; line-height: 1.65; }.comment-list text { color: #ce5884; font-weight: 750; }.post-actions { display: flex; align-items: center; padding-top: 15rpx; border-top: 2rpx solid #f7eef2; }.post-action { display: flex; align-items: center; min-width: 82rpx; color: #8f9bad; font-size: 21rpx; }.post-action text { margin-right: 8rpx; font-size: 27rpx; }.post-action.liked { color: #ff4c8b; }.post-keepsake { margin-left: auto; color: #c58ba0; font-family: "STKaiti","KaiTi",serif; font-size: 18rpx; }
.records-empty { display: flex; align-items: center; flex-direction: column; justify-content: center; min-height: 390rpx; padding: 25rpx; box-sizing: border-box; color: var(--navy); text-align: center; }.records-empty image { width: 300rpx; height: 190rpx; }.records-empty view { margin-top: 3rpx; font-size: 27rpx; font-weight: 800; }.records-empty text { margin-top: 8rpx; color: #929eae; font-size: 20rpx; }
.wish-filter { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 16rpx; overflow: hidden; border: 2rpx solid #f1e8ed; border-radius: 25rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(99,64,81,.06); }.wish-filter>view { display: flex; align-items: center; justify-content: center; height: 72rpx; color: #909aa8; font-size: 24rpx; font-weight: 750; }.wish-filter>view.active { color: #fff; background: linear-gradient(135deg,#ff72a4,#ff4c8b); }.wish-filter text { display: inline-flex; align-items: center; justify-content: center; min-width: 31rpx; height: 31rpx; margin-left: 8rpx; border-radius: 16rpx; color: inherit; background: rgba(255,255,255,.24); font-size: 17rpx; }
.wish-list { display: flex; flex-direction: column; gap: 14rpx; }.wish-card { position: relative; display: flex; align-items: center; min-height: 148rpx; padding: 21rpx 18rpx 21rpx 22rpx; overflow: hidden; box-sizing: border-box; border: 2rpx solid #f1e6eb; border-radius: 29rpx; background: rgba(255,255,255,.96); box-shadow: 0 10rpx 24rpx rgba(110,70,89,.08); }.wish-card::before { position: absolute; top: 0; bottom: 0; left: 0; width: 7rpx; content: ''; background: #ff85ac; }.wish-tone-1::before { background: #ffd46f; }.wish-tone-2::before { background: #83cae7; }.wish-tone-3::before { background: #8fd0a0; }.wish-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 78rpx; height: 78rpx; border-radius: 24rpx; background: #fff2f7; font-size: 38rpx; }.wish-tone-1 .wish-icon { background: #fff9df; }.wish-tone-2 .wish-icon { background: #edf9ff; }.wish-tone-3 .wish-icon { background: #effaf1; }.wish-copy { min-width: 0; flex: 1; margin-left: 18rpx; }.wish-title { overflow: hidden; color: var(--navy); font-size: 27rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }.wish-meta { margin-top: 4rpx; color: #9aa5b3; font-size: 18rpx; }.wish-note { display: inline-block; max-width: 380rpx; margin-top: 10rpx; padding: 6rpx 10rpx; overflow: hidden; border-radius: 10rpx; color: #cf648c; background: #fff0f5; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.wish-finish { margin-top: 8rpx; color: #6db17f; font-size: 18rpx; }.wish-check { display: flex; align-items: center; flex-direction: column; justify-content: center; flex: none; width: 72rpx; height: 72rpx; margin-left: 12rpx; border: 3rpx solid #ff7fab; border-radius: 50%; color: #ff4c8b; font-size: 30rpx; }.wish-check text { margin-top: -1rpx; font-size: 14rpx; }.wish-check.checked { border-color: #83c995; color: #fff; background: #83c995; }.wish-card.done { opacity: .82; }.wish-card.done .wish-title { text-decoration: line-through; text-decoration-color: #d4a