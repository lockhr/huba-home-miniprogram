page { background: #fff8fb; }
.schedule-page { min-height: 100vh; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); color: var(--navy); background: radial-gradient(circle at 86% 14%,rgba(255,199,220,.42),transparent 28%),linear-gradient(180deg,#fff5f9,#fbfcff 55%,#fff); }
.schedule-hero { position: relative; box-sizing: border-box; height: 330rpx; padding: 112rpx 240rpx 40rpx 38rpx; overflow: hidden; background: linear-gradient(135deg,#fff 2%,#fff0f6 62%,#ffe1ec); }
.schedule-back { position: absolute; z-index: 5; left: 28rpx; top: 56rpx; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border: 2rpx solid rgba(236,217,226,.85); border-radius: 22rpx; color: var(--navy); background: rgba(255,255,255,.78); box-shadow: 0 5rpx 15rpx rgba(87,62,76,.08); font-size: 46rpx; line-height: 1; }
.schedule-kicker { color: #d06d91; font-size: 18rpx; font-weight: 750; letter-spacing: 4rpx; }
.schedule-title { margin-top: 7rpx; font-size: 52rpx; font-weight: 900; letter-spacing: 3rpx; }
.schedule-subtitle { margin-top: 8rpx; color: #8090a5; font-size: 21rpx; line-height: 1.45; }
.schedule-hero-art { position: absolute; right: 18rpx; bottom: -24rpx; width: 250rpx; height: 250rpx; opacity: .94; }
.hero-bubble { position: absolute; color: rgba(255,76,139,.38); }.bubble-one { top: 83rpx; right: 225rpx; font-size: 26rpx; }.bubble-two { right: 32rpx; top: 90rpx; font-size: 36rpx; }
.schedule-content { position: relative; z-index: 2; margin-top: -24rpx; padding: 0 28rpx; }
.owner-switch { display: flex; gap: 14rpx; padding: 12rpx; border: 2rpx solid rgba(244,226,235,.92); border-radius: 30rpx; background: rgba(255,255,255,.94); box-shadow: var(--shadow); }
.owner-option { display: flex; align-items: center; min-width: 0; height: 102rpx; padding: 0 18rpx; border-radius: 23rpx; box-sizing: border-box; flex: 1; color: #8393a7; }
.owner-option.active { color: var(--navy); background: linear-gradient(135deg,#fff0f6,#ffe5ef); box-shadow: 0 7rpx 18rpx rgba(196,91,132,.11); }
.accent-mint .owner-option.active { background: linear-gradient(135deg,#f4fff7,#e4f8eb); box-shadow: 0 7rpx 18rpx rgba(78,157,102,.11); }
.owner-option image { width: 66rpx; height: 66rpx; margin-right: 12rpx; border-radius: 20rpx; background: rgba(255,255,255,.76); }
.owner-option view { display: flex; min-width: 0; flex-direction: column; }.owner-option view text:first-child { font-size: 25rpx; font-weight: 800; }.owner-option view text:last-child { margin-top: 3rpx; font-size: 17rpx; }
.schedule-import-card { margin-top: 22rpx; padding: 25rpx; border: 2rpx solid #f1e3ea; border-radius: 30rpx; background: rgba(255,255,255,.94); box-shadow: 0 10rpx 28rpx rgba(108,72,91,.07); }
.schedule-load-error { margin-top: 20rpx; padding: 20rpx 24rpx; border: 2rpx solid #f2cfdb; border-radius: 22rpx; color: #a7476b; background: #fff3f7; font-size: 21rpx; line-height: 1.5; }
.schedule-import-compact { display: flex; align-items: center; gap: 17rpx; margin-top: 20rpx; padding: 18rpx 22rpx; border: 2rpx solid #f1e3ea; border-radius: 24rpx; background: rgba(255,255,255,.92); box-shadow: 0 7rpx 20rpx rgba(108,72,91,.05); }
.schedule-import-compact-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; flex: none; border-radius: 21rpx; background: #fff0f5; font-size: 32rpx; }
.schedule-import-compact>view:nth-child(2) { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.schedule-import-compact>view:nth-child(2) text:first-child { color: var(--navy); font-size: 23rpx; font-weight: 800; }
.schedule-import-compact>view:nth-child(2) text:last-child { color: #bb5b81; font-size: 19rpx; }
.schedule-import-compact-arrow { color: #ce819e; font-size: 40rpx; line-height: 1; }
.schedule-import-heading { display: flex; justify-content: space-between; align-items: center; }.schedule-import-kicker { color: #cb7293; font-size: 17rpx; font-weight: 800; letter-spacing: 3rpx; }.schedule-import-title { margin-top: 5rpx; color: var(--navy); font-size: 30rpx; font-weight: 850; }.schedule-import-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 19rpx; background: #fff0f5; font-size: 30rpx; }
.schedule-import-note { margin-top: 12rpx; color: #77869b; font-size: 21rpx; line-height: 1.6; }.schedule-import-pick { display: flex; align-items: center; justify-content: center; height: 76rpx; margin-top: 20rpx; padding: 0; border: 2rpx solid #efc8d8; border-radius: 21rpx; color: #b94772; background: #fff5f9; font-size: 24rpx; font-weight: 750; line-height: 1.2; }.schedule-import-pick::after,.schedule-import-save::after { border: 0; }
.schedule-import-save { display: flex; align-items: center; justify-content: center; height: 80rpx; margin-top: 20rpx; padding: 0; border-radius: 22rpx; color: white; background: linear-gradient(110deg,#ff70a3,#ec4b86); font-size: 25rpx; font-weight: 800; line-height: 1.2; }.schedule-import-save[disabled] { color: #fff; background: #d9c4ce; }.schedule-import-error { margin-top: 14rpx; padding: 14rpx 17rpx; border-radius: 16rpx; color: #ad456c; background: #fff0f5; font-size: 20rpx; line-height: 1.5; }
.schedule-import-review { margin-top: 24rpx; padding-top: 23rpx; border-top: 2rpx solid #f2e8ed; }.schedule-import-review-head { display: flex; align-items: center; justify-content: space-between; color: var(--navy); font-size: 25rpx; font-weight: 800; }.schedule-import-review-head text { color: #ba6d8b; font-size: 20rpx; }.schedule-import-warning { margin-top: 9rpx; color: #8b95a6; font-size: 19rpx; line-height: 1.5; }.schedule-import-term,.schedule-import-fields input,.schedule-import-day { box-sizing: border-box; min-height: 70rpx; padding: 0 17rpx; border: 2rpx solid #f0e3e9; border-radius: 16rpx; background: #fff9fb; color: var(--navy); font-size: 22rpx; }.schedule-import-term { margin-top: 18rpx; }
.schedule-import-course { margin-top: 17rpx; padding: 18rpx; border: 2rpx solid #f2e8ed; border-radius: 20rpx; }.schedule-import-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 14rpx; }.schedule-import-fields picker { min-width: 0; }.schedule-import-day { display: flex; align-items: center; }.schedule-import-fields input { min-width: 0; width: 100%; }.schedule-import-add,.schedule-import-cancel { padding: 18rpx 8rpx 0; color: #c2527f; font-size: 22rpx; text-align: center; }.schedule-import-cancel { color: #8b98aa; }
.schedule-import-progress { margin-top: 15rpx; padding: 17rpx; border-radius: 17rpx; color: #ad5c7a; background: #fff4f8; font-size: 21rpx; text-align: center; }
.schedule-import-term-row { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; }
.schedule-import-term-row>text { flex: none; color: #75849b; font-size: 21rpx; }
.schedule-import-term-row .schedule-import-term { flex: 1; min-width: 0; margin-top: 0; }
.schedule-review-day { margin-top: 23rpx; }
.schedule-review-day-label { display: flex; align-items: center; justify-content: space-between; padding: 0 5rpx; color: var(--navy); font-size: 24rpx; font-weight: 850; }
.schedule-review-day-label text:last-child { color: #a7a1ad; font-size: 18rpx; font-weight: 500; }
.schedule-review-day .schedule-import-course { margin-top: 10rpx; padding: 0; overflow: hidden; border-color: #f3e5ec; background: linear-gradient(125deg,#fff,#fff9fc); }
.schedule-review-course-main { display: flex; align-items: center; min-height: 103rpx; gap: 12rpx; padding: 15rpx; }
.schedule-review-course-time { width: 135rpx; flex: none; color: #c3567f; font-size: 20rpx; font-weight: 800; line-height: 1.4; }
.schedule-review-course-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 5rpx; }
.schedule-review-course-copy text:first-child { overflow: hidden; color: var(--navy); font-size: 23rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.schedule-review-course-copy text:last-child { overflow: hidden; color: #8d9aab; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.schedule-review-course-edit { flex: none; color: #c8688d; font-size: 19rpx; }
.schedule-review-day .schedule-import-fields { padding: 0 15rpx 16rpx; border-top: 2rpx solid #f5e9ef; }
.schedule-import-remove { grid-column: 1 / -1; padding: 12rpx 0 2rpx; color: #b65c7e; font-size: 20rpx; text-align: right; }
.schedule-import-save-note { margin-top: 16rpx; text-align: center; }
.schedule-import-image-preview { display: flex; align-items: center; gap: 16rpx; min-height: 112rpx; margin-top: 18rpx; padding: 12rpx; border: 2rpx solid #f2e5ec; border-radius: 20rpx; background: #fff9fc; }
.schedule-import-image-preview image { width: 88rpx; height: 88rpx; flex: none; border-radius: 13rpx; background: #f8eef3; }
.schedule-import-image-preview view { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; }
.schedule-import-image-preview text:first-child { color: var(--navy); font-size: 22rpx; font-weight: 800; }
.schedule-import-image-preview text:last-child { color: #b46d88; font-size: 19rpx; line-height: 1.4; }
.schedule-import-modes { display: flex; gap: 10rpx; margin-top: 20rpx; padding: 7rpx; border-radius: 20rpx; background: #f9edf3; }
.schedule-import-mode { display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex: 1; min-width: 0; min-height: 70rpx; padding: 10rpx; border-radius: 16rpx; color: #936d81; font-size: 20rpx; font-weight: 700; text-align: center; }
.schedule-import-mode.active { color: #b84877; background: #fff; box-shadow: 0 5rpx 15rpx rgba(142,83,109,.12); }
.schedule-manual { margin-top: 23rpx; }
.schedule-manual-title { color: var(--navy); font-size: 25rpx; font-weight: 850; }
.schedule-manual-days { width: 100%; margin-top: 17rpx; white-space: nowrap; }
.schedule-manual-days-inner { display: inline-flex; gap: 10rpx; padding: 2rpx 2rpx 10rpx; }
.schedule-manual-day { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 94rpx; height: 65rpx; padding: 0 12rpx; border: 2rpx solid #f0e1e8; border-radius: 17rpx; color: #8a7583; background: #fff; font-size: 21rpx; font-weight: 700; }
.schedule-manual-day.active { border-color: #f48cb1; color: #b74070; background: #fff0f6; }
.schedule-manual-slots { display: flex; flex-direction: column; gap: 10rpx; margin-top: 10rpx; }
.schedule-manual-slot { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; min-height: 78rpx; padding: 12rpx 18rpx; border: 2rpx solid #eee3e9; border-radius: 18rpx; color: var(--navy); background: #fff; font-size: 22rpx; font-weight: 700; }
.schedule-manual-slot text:last-child { color: #a09aa6; font-size: 19rpx; font-weight: 600; }
.schedule-manual-slot.active { border-color: #ef8db2; background: #fff1f6; }
.schedule-manual-slot.active text:last-child { color: #c14a78; }
.schedule-manual-count { margin-top: 16rpx; color: #8b7382; font-size: 20rpx; line-height: 1.5; text-align: center; }
.day-strip { width: 100%; margin-top: 25rpx; white-space: nowrap; }.day-strip-inner { display: inline-flex; gap: 12rpx; padding: 2rpx 2rpx 12rpx; }
.day-chip { display: inline-flex; align-items: center; flex-direction: column; justify-content: center; width: 76rpx; height: 82rpx; border: 2rpx solid #f2e7ed; border-radius: 25rpx; color: #8e9aad; background: rgba(255,255,255,.86); box-shadow: 0 6rpx 16rpx rgba(86,61,73,.05); }
.day-chip text:first-child { font-size: 16rpx; }.day-chip text:last-child { margin-top: -1rpx; font-size: 27rpx; font-weight: 800; }
.day-chip.active { border-color: transparent; color: #fff; background: linear-gradient(145deg,#ff78a9,#ff4c8b); box-shadow: 0 10rpx 20rpx rgba(255,76,139,.23); transform: translateY(-3rpx); }.accent-mint .day-chip.active { background: linear-gradient(145deg,#7dcea0,#53b578); box-shadow: 0 10rpx 20rpx rgba(78,157,102,.2); }
.day-summary { display: flex; align-items: center; justify-content: space-between; margin: 17rpx 5rpx 14rpx; }.day-summary view { display: flex; align-items: center; font-size: 31rpx; font-weight: 850; }.day-summary>text { color: #8b98aa; font-size: 20rpx; }.summary-dot { width: 13rpx; height: 13rpx; margin-right: 12rpx; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 7rpx #ffe4ee; }.accent-mint .summary-dot { background: #5fbd7e; box-shadow: 0 0 0 7rpx #e5f8eb; }
.course-list { display: flex; flex-direction: column; gap: 15rpx; }
.course-card { position: relative; display: grid; grid-template-columns: 150rpx 20rpx minmax(0,1fr); min-height: 176rpx; padding: 24rpx 24rpx 22rpx 20rpx; overflow: hidden; border: 2rpx solid #f1e8ed; border-radius: 28rpx; background: rgba(255,255,255,.96); box-shadow: 0 10rpx 27rpx rgba(108,72,91,.08); box-sizing: border-box; }
.course-card::before { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; content: ''; background: #ff76a6; }.course-tone-1::before { background: #72c994; }.course-tone-2::before { background: #f3c85c; }.course-tone-3::before { background: #8aa9de; }.course-tone-4::before { background: #b998dc; }
.course-time { display: flex; flex-direction: column; justify-content: center; }.course-time text:first-child { color: var(--navy); font-size: 22rpx; font-weight: 800; }.course-time text:last-child { margin-top: 9rpx; color: #9ba7b7; font-size: 18rpx; }
.course-divider { display: flex; align-items: center; justify-content: center; }.course-divider text { width: 2rpx; height: 92rpx; background: #f0e5eb; }
.course-copy { min-width: 0; padding-left: 16rpx; }.course-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10rpx; }.course-title { min-width: 0; color: var(--navy); font-size: 28rpx; font-weight: 850; line-height: 1.35; }.course-week { flex: none; padding: 5rpx 9rpx; border-radius: 12rpx; color: #cc638a; background: #fff0f5; font-size: 16rpx; }
.course-meta { display: flex; flex-direction: column; gap: 7rpx; margin-top: 13rpx; color: #7d8da2; font-size: 19rpx; line-height: 1.4; }.course-sparkle { position: absolute; right: 9rpx; bottom: 4rpx; color: rgba(255,89,148,.22); font-size: 28rpx; }
.empty-schedule { display: flex; align-items: center; flex-direction: column; justify-content: center; height: 390rpx; border: 2rpx dashed #efdce5; border-radius: 30rpx; background: rgba(255,255,255,.72); }.empty-schedule image { width: 310rpx; height: 210rpx; }.empty-schedule view { margin-top: -12rpx; font-size: 29rpx; font-weight: 800; }.empty-schedule text { margin-top: 9rpx; color: #8b98aa; font-size: 21rpx; }
.schedule-note { display: flex; align-items: center; margin-top: 23rpx; padding: 22rpx 24rpx; border-radius: 25rpx; color: #7c8ba0; background: linear-gradient(120deg,#fff,#fff1f6); font-size: 20rpx; line-height: 1.5; }.schedule-note>text { margin-right: 16rpx; font-size: 38rpx; }.schedule-note view view { color: var(--navy); font-size: 23rpx; font-weight: 800; }.schedule-note view>text { display: block; margin-top: 4rpx; }
@media (max-width: 340px) { .schedule-hero { padding-right: 190rpx; }.schedule-hero-art { width: 210rpx; height: 210rpx; }.course-card { grid-template-columns: 126rpx 16rpx minmax(0,1fr); }.course-week { display: none; }.course-title { font-size: 25rpx; } }
