.space-notice { box-sizing: border-box; width: calc(100% - 56rpx); margin: 22rpx 28rpx 0; padding: 20rpx 24rpx; border: 2rpx solid #f6dcea; border-radius: 20rpx; color: #7a3f63; background: #fff6fa; font-size: 24rpx; line-height: 1.55; }
.space-invite-code { margin-top: 18rpx; padding: 20rpx; border: 2rpx dashed #f1c8d9; border-radius: 20rpx; color: var(--navy); background: #fff8fb; font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.space-invite-code-label { margin-bottom: 8rpx; color: var(--muted); font-size: 21rpx; }
.space-copy-button, .space-share-button { width: 100%; margin-top: 18rpx; padding: 0; border: none; border-radius: 40rpx; font-size: 27rpx; font-weight: 700; line-height: 84rpx; }
.space-copy-button { color: #fff; background: linear-gradient(135deg,#ff72a4,#ff3f83); }
.space-share-button { color: var(--pink); background: #fff2f7; }
.space-copy-button[disabled], .space-share-button[disabled] { color: #b9a5b2; background: #f4edf1; }
.space-copy-success { margin-top: 14rpx; color: #4f8d6a; font-size: 22rpx; font-weight: 650; text-align: center; }
.space-copy-fallback { margin-top: 16rpx; padding: 20rpx; border: 2rpx dashed #e9b9ce; border-radius: 20rpx; background: linear-gradient(145deg,#fff8fb,#fff); }
.space-copy-fallback-title { color: #9b3f67; font-size: 24rpx; font-weight: 750; }
.space-copy-fallback-note { margin-top: 8rpx; color: #876f7a; font-size: 21rpx; line-height: 1.55; }
.space-copy-fallback-code { display: block; margin-top: 14rpx; padding: 16rpx; overflow-wrap: anywhere; border-radius: 16rpx; color: var(--navy); background: #fff0f6; font-size: 23rpx; line-height: 1.55; }
.space-copy-fallback-tip { margin-top: 10rpx; color: var(--pink); font-size: 21rpx; font-weight: 650; text-align: center; }
.lifecycle-card { box-sizing: border-box; display: flex; width: calc(100% - 56rpx); margin: 24rpx 28rpx; padding: 28rpx 26rpx 28rpx 22rpx; border: 2rpx solid #eadce3; border-radius: 30rpx; background: linear-gradient(145deg,#fffdfd,#fff6f9); box-shadow: 0 18rpx 42rpx rgba(94,54,74,.08); }
.lifecycle-rail { position: relative; flex: none; width: 30rpx; margin-right: 18rpx; }
.lifecycle-dot { position: relative; z-index: 1; width: 20rpx; height: 20rpx; margin: 6rpx auto 0; border: 6rpx solid #fff; border-radius: 50%; background: #e7658c; box-shadow: 0 0 0 2rpx #e7b8c9; }
.lifecycle-line { position: absolute; top: 32rpx; bottom: 4rpx; left: 14rpx; width: 2rpx; background: linear-gradient(#e9bdcc,transparent); }
.lifecycle-content { flex: 1; min-width: 0; }
.lifecycle-kicker { color: #b05b79; font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.lifecycle-title { margin-top: 7rpx; color: #493541; font-size: 31rpx; font-weight: 850; }
.lifecycle-message { margin-top: 12rpx; color: #806c76; font-size: 23rpx; line-height: 1.7; }
.lifecycle-actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.lifecycle-primary, .lifecycle-secondary, .lifecycle-danger { flex: 1; margin: 0; padding: 0 18rpx; border: 0; border-radius: 999rpx; font-size: 23rpx; font-weight: 750; line-height: 72rpx; }
.lifecycle-primary { color: #fff; background: linear-gradient(135deg,#365b78,#213f5b); }
.lifecycle-secondary { color: #765b68; background: #f5e9ee; }
.lifecycle-danger { color: #fff; background: linear-gradient(135deg,#d85b76,#b83d5a); }
.lifecycle-full { width: 100%; margin-top: 20rpx; }
.lifecycle-card-purging .lifecycle-dot { background: #47799a; box-shadow: 0 0 0 2rpx #b7d0df; }
.lifecycle-card-legacy { border-style: dashed; background: #fffaf1; }
.space-help-link { display: inline-flex; align-items: center; margin-top: 16rpx; padding: 10rpx 18rpx; border: 2rpx solid rgba(255,255,255,.72); border-radius: 999rpx; color: #6f4960; background: rgba(255,255,255,.62); font-size: 21rpx; font-weight: 700; }
.space-status-detail { margin-top: 14rpx; color: #a36d82; font-size: 21rpx; line-height: 1.55; }
.account-card { margin-top: 30rpx; border: 2rpx solid #f0dce4; background: #fffafb; }
