page { min-height: 100%; background: #fff7fa; }
.welcome-page { position: relative; min-height: 100vh; overflow: hidden; color: #253856; background: linear-gradient(162deg, #fffafd 0%, #fff0f6 48%, #f4f7ff 100%); }
.welcome-glow { position: absolute; border-radius: 50%; filter: blur(12rpx); opacity: .72; pointer-events: none; }
.welcome-glow-one { top: -150rpx; right: -120rpx; width: 420rpx; height: 420rpx; background: rgba(255,168,196,.28); }
.welcome-glow-two { bottom: 40rpx; left: -180rpx; width: 420rpx; height: 420rpx; background: rgba(163,190,255,.20); }
.welcome-shell { position: relative; z-index: 1; box-sizing: border-box; width: 100%; max-width: 760rpx; min-height: 100vh; margin: 0 auto; padding: 72rpx 40rpx calc(56rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.welcome-brand { padding: 18rpx 8rpx 32rpx; }
.welcome-eyebrow { color: #d7688f; font-size: 20rpx; font-weight: 700; letter-spacing: 7rpx; }
.welcome-title { margin-top: 14rpx; color: #243854; font-family: "Songti SC", "STSong", serif; font-size: 58rpx; font-weight: 700; letter-spacing: 2rpx; line-height: 1.16; }
.welcome-subtitle { margin-top: 14rpx; color: #71809a; font-size: 25rpx; letter-spacing: 1rpx; }
.welcome-picture { position: relative; height: 360rpx; overflow: hidden; border: 10rpx solid rgba(255,255,255,.86); border-radius: 42rpx 42rpx 42rpx 10rpx; background: #f9dbe7; box-shadow: 0 28rpx 70rpx rgba(155,71,110,.17); transform: rotate(-1deg); }
.welcome-hero { width: 100%; height: 100%; }
.welcome-picture::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 56%, rgba(46,36,69,.30)); }
.welcome-picture-tag { position: absolute; z-index: 1; right: 26rpx; bottom: 22rpx; color: rgba(255,255,255,.94); font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.welcome-state { margin-top: 38rpx; padding: 36rpx 34rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 32rpx; background: rgba(255,255,255,.78); box-shadow: 0 20rpx 50rpx rgba(73,58,91,.09); backdrop-filter: blur(20rpx); text-align: center; }
.welcome-state-ready { text-align: left; }
.welcome-state-title { color: #2b3b57; font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.welcome-state-note { margin-top: 12rpx; color: #71809a; font-size: 24rpx; line-height: 1.75; }
.welcome-loader { height: 44rpx; margin-bottom: 12rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.welcome-loader view { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ee7fa7; animation: welcome-breathe 1.2s ease-in-out infinite; }
.welcome-loader view:nth-child(2) { animation-delay: .15s; }
.welcome-loader view:nth-child(3) { animation-delay: .3s; }
.welcome-primary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 94rpx; margin-top: 28rpx; padding: 0 20rpx; border: 0; border-radius: 47rpx; color: #fff; background: linear-gradient(110deg, #ff5b98, #e9417d); box-shadow: 0 16rpx 34rpx rgba(225,65,123,.28); font-size: 28rpx; font-weight: 700; line-height: 1.25; }
.welcome-primary::after { border: 0; }
.welcome-primary[disabled] { color: rgba(255,255,255,.82); background: #e8a9bf; }
.welcome-secondary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 18rpx; padding: 0 20rpx; border: 2rpx solid rgba(215,104,143,.24); border-radius: 44rpx; color: #b65379; background: rgba(255,255,255,.74); font-size: 26rpx; font-weight: 700; line-height: 1.25; }
.welcome-secondary::after { border: 0; }
.welcome-secondary[disabled] { color: #b995a3; background: rgba(255,255,255,.54); }
.welcome-privacy-note { margin-top: 20rpx; color: #8c98aa; font-size: 20rpx; line-height: 1.65; text-align: center; }
.welcome-invite-note { margin-top: 20rpx; color: #ca5c85; font-size: 22rpx; text-align: center; }
.welcome-error-mark { width: 58rpx; height: 58rpx; margin: 0 auto 18rpx; border-radius: 50%; color: #c24f78; background: #ffe2ec; font-size: 34rpx; font-weight: 800; line-height: 58rpx; }
.welcome-safe-note { margin-top: 20rpx; color: #93a0b3; font-size: 20rpx; line-height: 1.6; }
@keyframes welcome-breathe { 0%, 100% { opacity: .35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-8rpx); } }
