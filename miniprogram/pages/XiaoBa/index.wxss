page { height: 100%; overflow: hidden; background: #fff9fb; }
.xiaoba-page { position: relative; display: flex; flex-direction: column; height: 100vh; overflow: hidden; color: #173955; background: linear-gradient(180deg,#fff0f6 0,#fff8fb 42%,#fbfcff 100%); }
.xiaoba-atmosphere { position: absolute; inset: 0 0 auto; height: 420rpx; overflow: hidden; pointer-events: none; }
.aurora { position: absolute; border-radius: 50%; filter: blur(16rpx); }
.aurora-a { top: -150rpx; right: -100rpx; width: 470rpx; height: 390rpx; background: radial-gradient(circle,rgba(255,157,193,.42),transparent 68%); }
.aurora-b { left: -190rpx; top: 82rpx; width: 430rpx; height: 270rpx; background: radial-gradient(circle,rgba(158,218,232,.29),transparent 70%); }
.sky-star { position: absolute; color: rgba(237,91,143,.45); }.star-one { right: 165rpx; top: 120rpx; font-size: 27rpx; }.star-two { left: 40rpx; top: 250rpx; color: rgba(72,139,169,.25); font-size: 36rpx; }
.xiaoba-header { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; flex: none; padding-right: 28rpx; padding-bottom: 10rpx; padding-left: 28rpx; box-sizing: border-box; }
.header-action { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 58rpx; border: 2rpx solid rgba(236,207,219,.9); border-radius: 23rpx; color: #254762; background: rgba(255,255,255,.78); box-shadow: 0 7rpx 18rpx rgba(110,69,88,.07); font-size: 43rpx; line-height: 1; }
.clear-action { color: #9b7484; font-size: 18rpx; font-weight: 700; letter-spacing: 0; }
.assistant-id { display: flex; align-items: center; }
.assistant-avatar { flex: none; width: 64rpx; height: 64rpx; margin-right: 13rpx; }
.assistant-id>view:last-child>view { color: #163a57; font-size: 27rpx; font-weight: 850; letter-spacing: 1rpx; }.assistant-id>view:last-child>text { display: block; margin-top: 2rpx; color: #947f89; font-size: 16rpx; }
.xiaoba-intro { position: relative; z-index: 3; display: flex; align-items: center; flex: none; min-height: 176rpx; margin: 8rpx 26rpx 0; padding: 24rpx 28rpx; overflow: hidden; border: 2rpx solid rgba(255,255,255,.96); border-radius: 34rpx; background: radial-gradient(circle at 88% 18%,rgba(255,194,217,.72),transparent 34%),linear-gradient(135deg,rgba(255,255,255,.98),rgba(255,238,245,.94)); box-shadow: 0 16rpx 38rpx rgba(151,84,111,.13); box-sizing: border-box; }
.intro-mark { position: relative; flex: none; width: 104rpx; height: 104rpx; margin-right: 22rpx; }.intro-mark>text { position: absolute; z-index: 6; right: -3rpx; bottom: -2rpx; padding: 4rpx 8rpx; border: 3rpx solid #fff; border-radius: 11rpx; color: #b96884; background: #fff5f7; box-shadow: 0 4rpx 9rpx rgba(173,96,123,.12); font-size: 13rpx; font-weight: 900; letter-spacing: 1rpx; }
.intro-copy { min-width: 0; flex: 1; }.intro-kicker { color: #d27094; font-size: 14rpx; font-weight: 750; letter-spacing: 2rpx; }.intro-title { margin-top: 6rpx; color: #173955; font-size: 34rpx; font-weight: 900; }.intro-note { max-width: 410rpx; margin-top: 8rpx; color: #7f8fa1; font-size: 19rpx; line-height: 1.45; }.intro-flower,.intro-heart { position: absolute; color: rgba(255,91,148,.25); }.intro-flower { right: 15rpx; top: 12rpx; font-size: 27rpx; }.intro-heart { right: 29rpx; bottom: 10rpx; font-size: 33rpx; transform: rotate(-8deg); }
.chat-scroll { position: relative; z-index: 4; min-height: 0; flex: 1; margin-top: 10rpx; box-sizing: border-box; }
.quick-prompts { width: 100%; white-space: nowrap; }.quick-prompts-row { display: inline-flex; gap: 10rpx; padding: 14rpx 26rpx 8rpx; }.quick-prompts-row>view { display: inline-flex; align-items: center; flex: none; height: 56rpx; padding: 0 17rpx; border: 2rpx solid #f0dfe7; border-radius: 22rpx; color: #5c7187; background: rgba(255,255,255,.9); box-shadow: 0 6rpx 16rpx rgba(105,68,87,.06); font-size: 18rpx; }.quick-prompts-row text { margin-right: 7rpx; color: #ec6898; }
.message-list { padding: 4rpx 25rpx 0; }.message-row { display: flex; align-items: flex-start; margin-top: 18rpx; animation: message-in 230ms ease-out both; }.message-row.user { justify-content: flex-end; }
.message-mini-avatar { display: flex; align-items: center; justify-content: center; flex: none; width: 52rpx; height: 52rpx; margin: 3rpx 11rpx 0 0; }
.message-wrap { max-width: 78%; }.message-bubble { padding: 18rpx 21rpx; border: 2rpx solid #eee3e8; border-radius: 9rpx 25rpx 25rpx 25rpx; color: #30495f; background: rgba(255,255,255,.97); box-shadow: 0 8rpx 20rpx rgba(75,54,66,.065); font-size: 23rpx; line-height: 1.67; white-space: pre-wrap; word-break: break-word; }.user .message-bubble { border-color: transparent; border-radius: 25rpx 9rpx 25rpx 25rpx; color: #fff; background: linear-gradient(135deg,#ff7ba8,#ef4f8a); box-shadow: 0 9rpx 22rpx rgba(225,65,123,.2); }.message-wrap>text { display: block; margin-top: 6rpx; color: #a4aab3; font-size: 15rpx; }.user .message-wrap>text { text-align: right; }
.typing { display: flex; align-items: center; height: 27rpx; }.typing-dot { width: 9rpx; height: 9rpx; margin-right: 8rpx; border-radius: 50%; background: #d7638e; animation: typing-dot 1.15s ease-in-out infinite; }.typing-dot:nth-child(2) { animation-delay: .16s; }.typing-dot:nth-child(3) { animation-delay: .32s; }.scroll-spacer { height: 184rpx; }
.composer-shell { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 7rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid rgba(239,220,228,.78); background: rgba(255,249,252,.96); box-shadow: 0 -11rpx 30rpx rgba(86,58,72,.075); transition: bottom 120ms ease-out; backdrop-filter: blur(18rpx); }.privacy-line { margin-bottom: 7rpx; color: #aa939e; font-size: 14rpx; text-align: center; }.privacy-line text { margin-right: 5rpx; color: #ed6998; }.composer { display: flex; align-items: flex-end; padding: 9rpx 9rpx 9rpx 20rpx; border: 2rpx solid #eadfe5; border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 21rpx rgba(75,52,64,.075); }.composer textarea { min-height: 52rpx; max-height: 132rpx; padding: 10rpx 0 6rpx; flex: 1; color: #25455f; font-size: 23rpx; line-height: 1.45; }.composer-placeholder { color: #adb3bc; }.send-button { display: flex; align-items: center; justify-content: center; flex: none; width: 66rpx; height: 66rpx; margin-left: 12rpx; border-radius: 25rpx; color: #fff; background: linear-gradient(145deg,#ff79a7,#f04482); box-shadow: 0 8rpx 18rpx rgba(225,62,120,.23); }.send-button>text { font-size: 34rpx; line-height: 1; transform: translateY(-1rpx); }.send-button.disabled { opacity: .4; box-shadow: none; }
@keyframes message-in { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } } @keyframes typing-dot { 0%,80%,100% { opacity: .35; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-5rpx); } }
@media (max-width: 340px) { .xiaoba-intro { margin-right: 18rpx; margin-left: 18rpx; padding: 20rpx; }.intro-mark { transform: scale(.86); transform-origin: left center; margin-right: 4rpx; }.intro-title { font-size: 30rpx; }.message-wrap { max-width: 82%; } }
