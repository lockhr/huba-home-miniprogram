/* Shared presentation only: retain WeUI gesture and action indices. */
.huba-actions .weui-slideview__right { background: #fff9fb; }
.huba-actions .weui-slideview__btn__wrp {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  min-width: 64px;
  box-sizing: border-box;
  padding: 8px 4px;
  background: #fff9fb;
}
.huba-actions .weui-slideview__btn__wrp::before { display: none; }
.huba-actions .weui-slideview__btn__wrp .weui-slideview__btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 56px;
  height: 60px;
  min-height: 44px;
  padding: 6px 2px;
  border: 1px solid #f4d5e1;
  border-radius: 17px;
  background: #fce7ef;
  color: #a13c63;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;
  transition: opacity 140ms ease, transform 140ms ease;
}
.huba-actions .weui-slideview__btn::before {
  content: '';
  display: block;
  flex-shrink: 0;
  width: 23px;
  height: 23px;
  margin-bottom: 4px;
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
}
.huba-actions .starBtn .weui-slideview__btn { background: #f6eff4; color: #80536c; border-color: #ebdfe8; }
.huba-actions .removeBtn .weui-slideview__btn { background: #fff1f2; color: #ac4055; border-color: #f4dadd; }
.huba-actions .weui-slideview__btn:active { opacity: .72; transform: scale(.96); }
